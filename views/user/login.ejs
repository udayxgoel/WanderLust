<% layout('/layouts/boilerplate') -%>

<div class="login-container">
  <div class="login-box">
    <h1 class="text-center">Login on <span>WanderLust</span></h1>
    <form
      method="POST"
      action="/user/login"
      class="needs-validation"
      novalidate
    >
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          type="text"
          name="username"
          class="form-control"
          id="username"
          required
        />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          type="password"
          name="password"
          class="form-control"
          id="password"
          required
        />
      </div>
      <button class="btn btn-success w-100">Login</button>
    </form>

    <p class="mt-3 text-center">
      Don't have an account?
      <a href="/user/signup" class="fw-bold text-success">Create one</a>
    </p>
  </div>
</div>
