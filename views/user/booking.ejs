<% layout('/layouts/boilerplate') -%>

<div class="container mt-4">
  <h2 class="fw-bold"><%= booking.listing.title %></h2>

  <p class="text-muted">
    📍
    <a href="#" class="text-decoration-none fw-bold"
      ><%= booking.listing.address %></a
    >
  </p>

  <div
    class="p-4 rounded bg-light d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center"
  >
    <div class="mb-3 mb-md-0">
      <h5 class="fw-bold">Your booking information</h5>
      <p class="mb-0">
        <i class="bi bi-moon-stars-fill"></i>
        <strong><%= booking.guests %> guests:</strong>
        <i class="bi bi-calendar"></i> <%= booking.checkIn.toDateString() %> →
        <%= booking.checkOut.toDateString() %>
      </p>
    </div>
    <div class="bg-danger text-white px-4 py-2 rounded text-center">
      <h5 class="fw-bold">Total price</h5>
      <h3 class="m-0">₹<%= booking.totalPrice %></h3>
    </div>
  </div>

  <div class="row mt-4 mb-4">
    <div class="col-12">
      <img
        src="<%= booking.listing.image.url %>"
        class="img-fluid w-100 rounded"
        style="height: 400px; object-fit: cover"
        alt="Listing Image"
      />
    </div>
  </div>
</div>
