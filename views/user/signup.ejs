<% layout('/layouts/boilerplate') -%>

<div class="signup-container">
  <div class="signup-box">
    <h1 class="text-center">Sign Up on <span>Wanderlust</span></h1>
    <form
      method="POST"
      action="/user/signup"
      class="needs-validation"
      novalidate
    >
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          type="text"
          name="username"
          class="form-control"
          id="username"
          required
        />
        <div class="valid-feedback">Looks good!</div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input
          type="email"
          name="email"
          class="form-control"
          id="email"
          required
        />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          type="password"
          name="password"
          class="form-control"
          id="password"
          required
        />
      </div>
      <button class="btn btn-success w-100">Sign Up</button>
    </form>

    <p class="mt-3 text-center">
      Already have an account?
      <a href="/user/login" class="fw-bold text-success">Login</a>
    </p>
  </div>
</div>
