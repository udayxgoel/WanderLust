<% layout('/layouts/boilerplate') -%>
<div class="row">
  <div class="col-8 offset-2">
    <br />
    <h2>Create a new Listing</h2>
    <form
      method="POST"
      action="/listings"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          name="listing[title]"
          placeholder="Add a catchy title"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title looks good!</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          name="listing[description]"
          placeholder="Enter description"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please enter a short description</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Upload Listing Image</label>
        <input
          type="file"
          name="listing[image]"
          class="form-control"
          required
        />
      </div>

      <div class="row">
        <div class="mb-3 col-md-6">
          <label for="price" class="form-label">Price</label>
          <input
            type="number"
            name="listing[price]"
            placeholder="1200"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Price should be valid</div>
        </div>

        <div class="mb-3 col-md-6">
          <label for="maxGuests" class="form-label">Maximum Guests</label>
          <input
            type="number"
            name="listing[maxGuests]"
            placeholder="4"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Please enter a valid number</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="address" class="form-label">Address</label>
        <input
          type="text"
          name="listing[address]"
          placeholder="Street, City, Country"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Address should be valid</div>
      </div>

      <div class="mb-3">
        <label for="perks" class="form-label">Perks</label>
        <div class="row" id="perksContainer">
          <% let allPerks = ["Wifi", "TV", "Free parking spot", "Radio", "Pets",
          "Private entrance"]; %> <% allPerks.forEach(perk => { %>
          <div class="col-md-4">
            <div
              class="form-check p-3 border rounded d-flex align-items-center"
            >
              <input
                type="checkbox"
                name="listing[perks]"
                value="<%= perk %>"
                class="form-check-input me-2 perk-checkbox"
              />
              <label class="form-check-label d-flex align-items-center">
                <%= perk %>
              </label>
            </div>
          </div>
          <% }) %>
        </div>
      </div>

      <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select class="form-select" name="listing[category]" id="category">
          <option selected disabled>Select a category</option>
          <option value="Rooms">Rooms</option>
          <option value="Iconic Cities">Iconic Cities</option>
          <option value="Mountains">Mountains</option>
          <option value="Castles">Castles</option>
          <option value="Amazing Pools">Amazing Pools</option>
          <option value="Camping">Camping</option>
          <option value="Arctic">Arctic</option>
          <option value="Farms">Farms</option>
          <option value="Domes">Domes</option>
          <option value="Boats">Boats</option>
        </select>
      </div>

      <div class="mb-3">
        <label for="extraInfo" class="form-label">Extra Info</label>
        <textarea
          name="listing[extraInfo]"
          placeholder="Any additional details..."
          class="form-control"
        ></textarea>
        <div class="valid-feedback">Extra information is optional</div>
      </div>

      <button class="btn add-btn">Add</button>
    </form>
  </div>
</div>
<br />
