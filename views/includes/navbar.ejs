<nav class="navbar bg-body-light border-bottom sticky-top">
  <div
    class="container-fluid d-flex justify-content-between align-items-center px-3"
  >
    <a class="nav-link d-flex align-items-center gap-2" href="/listings">
      <i class="fa-regular fa-compass"></i>
      <p class="logo-name fw-bold mb-0">WanderLust</p>
    </a>

    <form
      method="GET"
      action="/listings/search"
      class="d-none d-md-flex"
      role="search"
    >
      <input
        class="form-control me-2 search-input"
        type="search"
        placeholder="Search destination"
        name="country"
      />
      <button class="btn search-btn" type="submit">
        <i class="fa-solid fa-magnifying-glass"></i> Search
      </button>
    </form>

    <a
      href="<%= currUser ? '/user/profile' : '/user/login' %>"
      class="text-decoration-none"
    >
      <button
        class="btn d-flex align-items-center gap-2 border-0 px-3 py-2 user-btn"
      >
        <span>&#9776;</span>
        <img src="/assets/navbar-icon-user.png" alt="user-icon" width="30" />
        <% if (currUser) { %>
        <p class="mb-0 fw-bold text-dark"><%= currUser.username %></p>
        <% } %>
      </button>
    </a>
  </div>
</nav>
