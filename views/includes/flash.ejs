<% if(success && success.length){ %>
<div
  class="alert alert-success alert-dismissible fade show mx-auto text-center"
  role="alert"
  style="max-width: 90%"
>
  <%= success %>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %> <% if(error && error.length){ %>
<div
  class="alert alert-danger alert-dismissible fade show mx-auto text-center"
  role="alert"
  style="max-width: 90%"
>
  <%= error %>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %>
